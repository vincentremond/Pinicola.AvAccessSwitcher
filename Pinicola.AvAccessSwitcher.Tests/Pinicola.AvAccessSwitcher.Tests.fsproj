<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <WarningsAsErrors>FS0025</WarningsAsErrors>
    <NoWarn>$(NoWarn);NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="paket.references" />
    <Compile Include="NativeDisplayTests.fs" />
    <Compile Include="KvmDetectorTests.fs" />
    <Compile Include="CursorActivityTests.fs" />
    <Compile Include="TrayApplicationTests.fs" />
    <Compile Include="ProgramTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pinicola.AvAccessSwitcher\Pinicola.AvAccessSwitcher.fsproj" />
  </ItemGroup>

  <Import Project="..\.paket\Paket.Restore.targets" />

</Project>
